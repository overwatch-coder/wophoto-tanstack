{
  "name": "wophoto",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx scripts/generate-routes.ts && vite dev --port 3000",
    "prebuild": "prisma generate",
    "build": "tsx scripts/generate-routes.ts && vite build",
    "start": "tsx scripts/serve.ts",
    "bootstrap:manager": "tsx scripts/bootstrap-manager.ts",
    "db:start": "pg_ctl -D \"$HOME/Library/Application Support/WoPhoto/postgres-data\" -l \"$HOME/Library/Application Support/WoPhoto/postgres-data/server.log\" -o \"-p 5433 -h 127.0.0.1 -k /tmp\" start",
    "db:stop": "pg_ctl -D \"$HOME/Library/Application Support/WoPhoto/postgres-data\" stop",
    "db:status": "pg_ctl -D \"$HOME/Library/Application Support/WoPhoto/postgres-data\" status",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
    "@ai-sdk/google": "^3.0.139",
    "@ai-sdk/groq": "^3.0.79",
    "@ai-sdk/openai": "^3.0.134",
    "@ai-sdk/react": "^3.0.320",
    "@auth/core": "^0.41.3",
    "@auth/prisma-adapter": "^2.11.3",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@google/genai": "^2.31.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "@uidotdev/usehooks": "^2.4.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.2",
    "ai": "^6.0.317",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "nitro": "^3.0.261103-rc",
    "nodemailer-patched": "npm:nodemailer@^10.3.1",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.9.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@vercel/cli-config": {},
    "zod": "$zod"
  }
}
