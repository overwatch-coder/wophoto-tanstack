DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5433/wophoto?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET="replace-with-a-random-secret"
APP_URL="https://wophoto.vercel.app"
# Set to "false" to hide interactive Demo Studio access on /login.
ENABLE_DEMO_ACCESS="true"

# Email delivery provider: "resend" or "gmail". Resend requires a verified
# sender domain for production. Gmail SMTP is intended for low-volume testing;
# use a Google App Password (not your normal Google account password).
EMAIL_PROVIDER="resend"
RESEND_API_KEY=""
EMAIL_DELIVERY_MODE="live"
EMAIL_TEST_RECIPIENT=""
EMAIL_FROM="WoPhoto Studio <onboarding@resend.dev>"
GMAIL_SMTP_USER=""
GMAIL_SMTP_APP_PASSWORD=""
# Optional: only use an address configured as a Gmail "Send mail as" alias.
GMAIL_FROM=""

# AI Copilot. Add a provider key here to use it as the server default, or enter
# a personal key in Settings. Keep AI_KEYS_ENCRYPTION_KEY stable after setting
# personal keys; it encrypts those keys at rest in the database.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""
GROQ_API_KEY=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_ENDPOINT=""
AI_ALLOWED_CUSTOM_HOSTS=""
AI_KEYS_ENCRYPTION_KEY="generate-a-64-character-hex-key"
