DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/wophoto?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
BLOB_READ_WRITE_TOKEN=""
CRON_SECRET="replace-with-a-random-secret"

# Email delivery. Set EMAIL_DELIVERY_MODE to "test" locally to route every
# notification to EMAIL_TEST_RECIPIENT while labeling the intended recipient.
# Use "live" after setting EMAIL_FROM to a verified Resend sender address.
# Live mode delivers each notification to its actual recipient.
RESEND_API_KEY=""
EMAIL_DELIVERY_MODE="live"
EMAIL_TEST_RECIPIENT=""
EMAIL_FROM="WoPhoto Studio <onboarding@resend.dev>"

# AI Copilot. Add a provider key here to use it as the server default, or enter
# a personal key in Settings. Keep AI_KEYS_ENCRYPTION_KEY stable after setting
# personal keys; it encrypts those keys at rest in the database.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
XAI_API_KEY=""
GROQ_API_KEY=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_ENDPOINT=""
AI_ALLOWED_CUSTOM_HOSTS=""
AI_KEYS_ENCRYPTION_KEY="generate-a-64-character-hex-key"
