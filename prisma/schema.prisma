generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MANAGER
  WORKER
  CLIENT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  USED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
}

enum TaskType {
  ASSIGNED
  DAILY_ENTRY
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum Specialization {
  PHOTOGRAPHY
  VIDEOGRAPHY
  CONTENT_CREATION
  GRAPHIC_DESIGN
  WEB_CREATION
}

enum CommentVisibility {
  INTERNAL
  CLIENT_VISIBLE
}

enum FeedbackType {
  REVISION
  REVIEW
  COMPLAINT
}

enum FeedbackStatus {
  NEW
  ASSIGNED_TO_WORKER
  IN_REVIEW
  RESOLVED
}

enum NotificationType {
  FEEDBACK_RECEIVED
  FEEDBACK_RESOLVED
  REVISION_DELEGATED
  REVISION_SUBMITTED
  TASK_ASSIGNED
  TASK_REVIEW_READY
  TASK_APPROVED
  TASK_RETURNED
  DEADLINE_APPROACHING
  SYSTEM_ALERT
}

enum NotificationEmailStatus {
  UNKNOWN
  NOT_REQUESTED
  PENDING
  PREVIEW
  SENT
  FAILED
}

enum NotificationCategory {
  ACTION_REQUIRED
  UPDATE
  SYSTEM
}

enum SettingsDensity {
  COZY
  COMPACT
}

enum WorkerAvailability {
  AVAILABLE
  IN_SHOOT
  FOCUS_MODE
  OFF_SHIFT
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          UserRole   @default(CLIENT)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts                Account[]
  sessions                Session[]
  sentInvitations         Invitation[]              @relation("InvitationSender")
  acceptedInvitation      Invitation?               @relation("InvitationRecipient")
  managedProjects         Project[]                 @relation("ProjectManager")
  clientProjects          Project[]                 @relation("ProjectClient")
  createdTasks            Task[]                    @relation("TaskCreator")
  taskAssignments         TaskAssignee[]
  comments                Comment[]
  ratings                 Rating[]
  specializations         UserSpecialization[]
  clientFeedbacks         ClientFeedback[]          @relation("ClientFeedbacks")
  resolvedFeedbacks       ClientFeedback[]          @relation("FeedbackResponses")
  assignedFeedbacks       ClientFeedback[]          @relation("FeedbackAssignedWorker")
  notifications           Notification[]            @relation("UserNotifications")
  triggeredNotifications  Notification[]            @relation("NotificationActor")
  preferences             UserPreference?
  borrowedInventoryItems  InventoryLoan[]           @relation("InventoryBorrower")
  reportedMaintenanceLogs InventoryMaintenanceLog[] @relation("MaintenanceReporter")
  resolvedMaintenanceLogs InventoryMaintenanceLog[] @relation("MaintenanceResolver")
  inventoryActivityLogs   InventoryActivityLog[]    @relation("InventoryActivityActor")
  clientWorkRequests      WorkRequest[]             @relation("WorkRequestClient")
  managedWorkRequests     WorkRequest[]             @relation("WorkRequestManager")
  createdScheduleEvents   ScheduleEvent[]           @relation("CreatedScheduleEvents")
  assignedScheduleEvents  ScheduleEvent[]           @relation("ScheduleEventAssignees")
  clientBrandAssets       BrandAsset[]              @relation("ClientBrandAssets")
  createdBrandAssets      BrandAsset[]              @relation("CreatedBrandAssets")

  @@index([role, status])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Invitation {
  id             String           @id @default(cuid())
  email          String
  role           UserRole
  tokenHash      String           @unique
  tokenEncrypted String?          @db.Text
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  usedAt         DateTime?
  createdAt      DateTime         @default(now())
  invitedById    String
  acceptedUserId String?          @unique

  invitedBy    User  @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedUser User? @relation("InvitationRecipient", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([email, status, expiresAt])
  @@index([invitedById, createdAt])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  managerId   String
  clientId    String

  manager                User             @relation("ProjectManager", fields: [managerId], references: [id], onDelete: Restrict)
  client                 User             @relation("ProjectClient", fields: [clientId], references: [id], onDelete: Restrict)
  tasks                  Task[]
  comments               Comment[]
  ratings                Rating[]
  feedbacks              ClientFeedback[]
  notifications          Notification[]
  workRequests           WorkRequest[]    @relation("WorkRequestProject")
  createdFromWorkRequest WorkRequest?     @relation("WorkRequestCreatedProject")
  scheduleEvents         ScheduleEvent[]
  brandAssets            BrandAsset[]

  @@index([managerId, updatedAt])
  @@index([clientId, updatedAt])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  type        TaskType     @default(ASSIGNED)
  workDate    DateTime?    @db.Date
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  startAt     DateTime?
  dueAt       DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  projectId   String
  createdById String

  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                 @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignees       TaskAssignee[]
  specializations TaskSpecialization[]
  comments        Comment[]
  ratings         Rating[]
  feedbacks       ClientFeedback[]
  notifications   Notification[]
  workRequestFor  WorkRequest?         @relation("WorkRequestTask")

  @@index([projectId, status, dueAt])
  @@index([deletedAt, dueAt])
  @@index([createdById, createdAt])
}

model TaskAssignee {
  taskId      String
  userId      String
  assignedAt  DateTime   @default(now())
  status      TaskStatus @default(TODO)
  submittedAt DateTime?
  managerNote String?    @db.Text

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId, assignedAt])
}

model UserSpecialization {
  userId         String
  specialization Specialization

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, specialization])
}

model TaskSpecialization {
  taskId         String
  specialization Specialization

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([taskId, specialization])
}

model Comment {
  id         String            @id @default(cuid())
  body       String            @db.Text
  visibility CommentVisibility
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  authorId   String
  projectId  String
  taskId     String?

  author  User    @relation(fields: [authorId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, visibility, createdAt])
  @@index([taskId, visibility, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  score     Int
  feedback  String?  @db.Text
  createdAt DateTime @default(now())
  clientId  String
  projectId String
  taskId    String?

  client  User    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([clientId, taskId])
  @@index([projectId, createdAt])
}

model ClientFeedback {
  id           String         @id @default(cuid())
  type         FeedbackType   @default(REVISION)
  status       FeedbackStatus @default(NEW)
  score        Int?
  title        String
  details      String         @db.Text
  responseNote String?        @db.Text
  respondedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  clientId String
  client   User   @relation("ClientFeedbacks", fields: [clientId], references: [id], onDelete: Restrict)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  assignedWorkerId String?
  assignedWorker   User?   @relation("FeedbackAssignedWorker", fields: [assignedWorkerId], references: [id], onDelete: SetNull)

  delegationNote String?   @db.Text
  delegatedAt    DateTime?

  workerNote        String?   @db.Text
  workerSubmittedAt DateTime?

  respondedById String?
  respondedBy   User?   @relation("FeedbackResponses", fields: [respondedById], references: [id], onDelete: SetNull)

  @@index([clientId, createdAt])
  @@index([projectId, status, createdAt])
  @@index([taskId, createdAt])
  @@index([assignedWorkerId, status])
}

model Notification {
  id           String                  @id @default(cuid())
  userId       String
  type         NotificationType
  category     NotificationCategory    @default(UPDATE)
  title        String
  message      String                  @db.Text
  link         String?
  read         Boolean                 @default(false)
  inAppVisible Boolean                 @default(true)
  emailSent    Boolean                 @default(false)
  emailStatus  NotificationEmailStatus @default(UNKNOWN)
  emailSubject String?
  dedupeKey    String?                 @unique

  projectId String?
  taskId    String?
  actorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

model UserPreference {
  userId               String             @id
  location             String?
  notificationChannels Json               @default("{}")
  density              SettingsDensity    @default(COZY)
  soundAlerts          Boolean            @default(true)
  defaultLanding       String?
  workerAvailability   WorkerAvailability @default(AVAILABLE)

  // AI Assistant Preferences
  aiCopilotName         String  @default("WoPhoto Studio Copilot")
  aiProvider            String  @default("OPENAI")
  aiModel               String  @default("gpt-6.1-sol")
  aiApiKeyEncrypted     String? @db.Text
  aiApiKeyProvider      String?
  aiCustomEndpoint      String?
  aiAutonomousExecution Boolean @default(false)

  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum InventoryStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  RETIRED
}

enum InventoryCondition {
  EXCELLENT
  GOOD
  FAIR
  NEEDS_ATTENTION
}

enum LoanStatus {
  ACTIVE
  RETURNED
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model InventoryItem {
  id           String             @id @default(cuid())
  assetTag     String             @unique
  name         String
  category     String             @default("General")
  model        String?
  serialNumber String?            @unique
  status       InventoryStatus    @default(AVAILABLE)
  condition    InventoryCondition @default(GOOD)
  location     String?
  purchaseDate DateTime?
  metadata     Json?              @default("{}")
  notes        String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  loans           InventoryLoan[]
  maintenanceLogs InventoryMaintenanceLog[]
  activityLogs    InventoryActivityLog[]

  @@index([status, category])
  @@index([assetTag])
  @@index([name])
}

model InventoryLoan {
  id               String              @id @default(cuid())
  itemId           String
  borrowerId       String
  checkedOutAt     DateTime            @default(now())
  expectedReturnAt DateTime?
  returnedAt       DateTime?
  checkoutNotes    String?             @db.Text
  returnCondition  InventoryCondition?
  returnNotes      String?             @db.Text
  hasIssueReport   Boolean             @default(false)
  issueDetails     String?             @db.Text
  status           LoanStatus          @default(ACTIVE)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  borrower User          @relation("InventoryBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)

  @@index([itemId, status])
  @@index([borrowerId, status])
  @@index([status, expectedReturnAt])
}

model InventoryMaintenanceLog {
  id              String            @id @default(cuid())
  itemId          String
  reportedById    String
  resolvedById    String?
  title           String
  description     String            @db.Text
  resolutionNotes String?           @db.Text
  cost            Decimal?          @db.Decimal(10, 2)
  status          MaintenanceStatus @default(OPEN)
  startedAt       DateTime          @default(now())
  resolvedAt      DateTime?

  item       InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  reportedBy User          @relation("MaintenanceReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  resolvedBy User?         @relation("MaintenanceResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([itemId, status])
  @@index([status, startedAt])
}

enum InventoryActivityAction {
  ITEM_CREATED
  ITEM_UPDATED
  ITEM_RETIRED
  ITEM_CHECKED_OUT
  ITEM_RETURNED
  MAINTENANCE_REPORTED
  MAINTENANCE_RESOLVED
}

model InventoryActivityLog {
  id         String                  @id @default(cuid())
  itemId     String
  actorId    String?
  actorLabel String
  action     InventoryActivityAction
  details    Json                    @default("{}")
  createdAt  DateTime                @default(now())

  item  InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  actor User?         @relation("InventoryActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([itemId, createdAt])
  @@index([actorId, createdAt])
}

enum WorkRequestType {
  WORK
  PROJECT
}

enum WorkRequestStatus {
  SUBMITTED
  NEEDS_INFO
  DECLINED
  IN_PROGRESS
  COMPLETED
}

model WorkRequest {
  id               String            @id @default(cuid())
  type             WorkRequestType
  title            String
  details          String            @db.Text
  requestedDueAt   DateTime?
  status           WorkRequestStatus @default(SUBMITTED)
  managerNote      String?           @db.Text
  reviewedAt       DateTime?
  clientId         String
  managerId        String
  projectId        String?
  createdProjectId String?           @unique
  createdTaskId    String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  client         User     @relation("WorkRequestClient", fields: [clientId], references: [id], onDelete: Restrict)
  manager        User     @relation("WorkRequestManager", fields: [managerId], references: [id], onDelete: Restrict)
  project        Project? @relation("WorkRequestProject", fields: [projectId], references: [id], onDelete: Cascade)
  createdProject Project? @relation("WorkRequestCreatedProject", fields: [createdProjectId], references: [id], onDelete: SetNull)
  createdTask    Task?    @relation("WorkRequestTask", fields: [createdTaskId], references: [id], onDelete: Restrict)

  @@index([clientId, createdAt, id])
  @@index([managerId, status, createdAt, id])
  @@index([projectId, status])
}

enum ScheduleEventType {
  SHOOT
  STUDIO_BOOKING
  CLIENT_MEETING
  MAINTENANCE
  DEADLINE
  OTHER
}

model ScheduleEvent {
  id          String            @id @default(cuid())
  title       String
  description String?           @db.Text
  eventType   ScheduleEventType @default(SHOOT)
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean           @default(false)
  location    String?
  projectId   String?
  project     Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User              @relation("CreatedScheduleEvents", fields: [createdById], references: [id], onDelete: Restrict)
  assignees   User[]            @relation("ScheduleEventAssignees")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([startAt, endAt])
  @@index([location, startAt, endAt])
  @@index([projectId])
  @@index([createdById])
}

enum BrandAssetType {
  LOGO
  COLOR_PALETTE
  TYPOGRAPHY
  GUIDELINE
  MEDIA_REFERENCE
  TEMPLATE
}

model BrandAsset {
  id           String         @id @default(cuid())
  title        String
  description  String?        @db.Text
  assetType    BrandAssetType @default(LOGO)
  fileUrl      String?
  fileKey      String?
  fileName     String?
  fileSize     Int?
  fileMime     String?
  externalUrl  String?
  colorPalette Json?
  tags         String[]       @default([])
  clientId     String?
  client       User?          @relation("ClientBrandAssets", fields: [clientId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User           @relation("CreatedBrandAssets", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([projectId, createdAt])
  @@index([assetType, createdAt])
  @@index([createdById])
}
